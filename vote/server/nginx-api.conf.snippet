# Verna vote API — include this location inside the server{} block for
# verna.143143.eu.org. proxy_pass has no trailing URI, so /api/next is
# forwarded unchanged; server.py strips the /api prefix itself.
location /api/ {
    proxy_pass http://127.0.0.1:8790;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Connection "";
    proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Real-IP $remote_addr;

    proxy_buffering off;
    # http 层开着 proxy_intercept_errors，会把后端的 4xx JSON 换成 nginx 错误页，这里关掉
    proxy_intercept_errors off;

    proxy_connect_timeout 5s;
    proxy_send_timeout 30s;
    proxy_read_timeout 30s;

    # An http/server level limit_req is inherited by locations that do not
    # define their own limit_req. Dry-run mode keeps the inherited rule from
    # rejecting API calls without declaring a new limit_req here.
    # Requires nginx >= 1.17.0.
    limit_req_dry_run on;
}
